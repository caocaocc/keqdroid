+// The first request creates one HTTP/2 connection through the exact sing-box
+// pool and embedded Xray bridge. Completing its DNS-style context must not
+// cancel another in-flight request sharing that connection.
+func TestDoHFirstRequestCancellationPreservesSharedConnection(t *testing.T) {
+	for _, protocol := range []string{"freedom", "vless"} {
+		t.Run(protocol, func(t *testing.T) {
+			firstEntered := make(chan struct{})
+			secondEntered := make(chan struct{})
+			releaseSecond := make(chan struct{})
+			var release sync.Once
+			unblock := func() { release.Do(func() { close(releaseSecond) }) }
+			defer unblock()
+			server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.ProtoMajor != 2 {
+					t.Errorf("expected HTTP/2, got %s", r.Proto)
+					return
+				}
+				switch r.URL.Path {
+				case "/first":
+					close(firstEntered)
+					select {
+					case <-secondEntered:
+					case <-r.Context().Done():
+						return
+					}
+				case "/second":
+					close(secondEntered)
+					select {
+					case <-releaseSecond:
+					case <-r.Context().Done():
+						return
+					}
+				default:
+					t.Errorf("unexpected local path")
+					return
+				}
+				w.WriteHeader(http.StatusOK)
+				io.WriteString(w, "local-response")
+			}))
+			server.EnableHTTP2 = true
+			server.StartTLS()
+			defer server.Close()
+			// Ensure the gated handler cannot hold httptest.Close on failure.
+			defer unblock()
+			roots := x509.NewCertPool()
+			roots.AddCert(server.Certificate())
+			engine := localClientEngine(t, protocol)
+			dialer := &localHTTP2Dialer{engine: engine, tlsConfig: &tls.Config{RootCAs: roots, ServerName: "127.0.0.1", NextProtos: []string{"h2"}}, observed: make(chan context.Context, 1)}
+			destination, _ := url.Parse(server.URL)
+			host, rawPort, _ := net.SplitHostPort(destination.Host)
+			port, _ := strconv.Atoi(rawPort)
+			transport := dnsTransport.NewHTTPSTransportWrapper(dialer, M.ParseSocksaddrHostPort(host, uint16(port)), destination)
+			defer transport.Close()
+			session, stop := context.WithTimeout(t.Context(), 5*time.Second)
+			defer stop()
+			first, cancelFirst := context.WithCancel(session)
+			defer cancelFirst()
+			request := func(ctx context.Context, path string) error {
+				req, err := http.NewRequestWithContext(ctx, http.MethodPost, server.URL+path, nil)
+				if err != nil {
+					return err
+				}
+				response, err := transport.RoundTrip(req)
+				if err != nil {
+					return err
+				}
+				defer response.Body.Close()
+				body, err := io.ReadAll(response.Body)
+				if err == nil && string(body) != "local-response" {
+					return fmt.Errorf("unexpected local body")
+				}
+				return err
+			}
+			firstResult := make(chan error, 1)
+			secondResult := make(chan error, 1)
+			go func() { firstResult <- request(first, "/first") }()
+			select {
+			case <-firstEntered:
+			case err := <-firstResult:
+				t.Fatalf("first request failed before handler: %v", err)
+			case <-session.Done():
+				t.Fatal("first request did not arrive")
+			}
+			connectionContext := <-dialer.observed
+			go func() { secondResult <- request(session, "/second") }()
+			select {
+			case err := <-firstResult:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-session.Done():
+				t.Fatal("first request did not finish")
+			}
+			if dialer.calls.Load() != 1 {
+				t.Fatalf("requests did not share one connection: %d", dialer.calls.Load())
+			}
+			cancelFirst() // Matches dns.Client.Exchange's cancel after transport.Exchange.
+			if connectionContext.Err() != nil {
+				t.Fatalf("completed query cancellation reached the shared connection: %v", connectionContext.Err())
+			}
+			unblock()
+			select {
+			case err := <-secondResult:
+				if err != nil {
+					t.Fatalf("second response: %v", err)
+				}
+			case <-session.Done():
+				t.Fatal("second response did not finish")
+			}
+			if dialer.calls.Load() != 1 {
+				t.Fatalf("connection was replaced instead of preserved: %d", dialer.calls.Load())
+			}
+		})
+	}
+}
