+func TestDoHPendingTLSHonorsCancellationAndDeadline(t *testing.T) {
+	for _, cancelMode := range []string{"cancel", "deadline"} {
+		t.Run(cancelMode, func(t *testing.T) {
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer listener.Close()
+			entered := make(chan struct{})
+			peerClosed := make(chan struct{})
+			go func() {
+				conn, err := listener.Accept()
+				if err != nil {
+					return
+				}
+				defer conn.Close()
+				close(entered)
+				io.Copy(io.Discard, conn) // Consume ClientHello without answering TLS.
+				close(peerClosed)
+			}()
+			engine := localClientEngine(t, "freedom")
+			dialer := &localHTTP2Dialer{engine: engine, tlsConfig: &tls.Config{ServerName: "127.0.0.1", NextProtos: []string{"h2"}}, observed: make(chan context.Context, 1), finished: make(chan struct{}, 1)}
+			destination, _ := url.Parse("https://" + listener.Addr().String())
+			addr := listener.Addr().(*net.TCPAddr)
+			transport := dnsTransport.NewHTTPSTransportWrapper(dialer, M.ParseSocksaddrHostPort("127.0.0.1", uint16(addr.Port)), destination)
+			defer transport.Close()
+			type key struct{}
+			ctx := context.WithValue(t.Context(), key{}, "local-metadata")
+			var cancel context.CancelFunc
+			if cancelMode == "deadline" {
+				ctx, cancel = context.WithTimeout(ctx, time.Second)
+			} else {
+				ctx, cancel = context.WithCancel(ctx)
+			}
+			defer cancel()
+			result := make(chan error, 1)
+			go func() {
+				req, _ := http.NewRequestWithContext(ctx, http.MethodPost, destination.String(), nil)
+				_, err := transport.RoundTrip(req)
+				result <- err
+			}()
+			select {
+			case <-entered:
+			case <-time.After(4 * time.Second):
+				t.Fatal("TLS dialing did not begin")
+			}
+			lifetime := <-dialer.observed
+			if lifetime.Value(key{}) != "local-metadata" {
+				t.Fatal("dial metadata lost")
+			}
+			expected := context.DeadlineExceeded
+			if cancelMode == "cancel" {
+				expected = context.Canceled
+				cancel()
+			}
+			select {
+			case err := <-result:
+				if !errors.Is(err, expected) {
+					t.Fatalf("caller error: %v", err)
+				}
+			case <-time.After(4 * time.Second):
+				t.Fatal("caller cancellation was lost")
+			}
+			select {
+			case <-dialer.finished:
+			case <-time.After(4 * time.Second):
+				t.Fatal("TLS dial outlived cancellation")
+			}
+			if !errors.Is(context.Cause(lifetime), expected) {
+				t.Fatalf("dial cause: %v", context.Cause(lifetime))
+			}
+			select {
+			case <-peerClosed:
+			case <-time.After(4 * time.Second):
+				t.Fatal("cancelled TLS left local TCP open")
+			}
+		})
+	}
+}
