+func TestDoHShutdownOwnsActiveOldAndClonedConnections(t *testing.T) {
+	entered := make(chan string, 2)
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { entered <- r.URL.Path; <-r.Context().Done() }))
+	server.EnableHTTP2 = true
+	server.StartTLS()
+	defer server.Close()
+	roots := x509.NewCertPool()
+	roots.AddCert(server.Certificate())
+	engine := localClientEngine(t, "vless")
+	dialer := &localHTTP2Dialer{engine: engine, tlsConfig: &tls.Config{RootCAs: roots, ServerName: "127.0.0.1", NextProtos: []string{"h2"}}, observed: make(chan context.Context, 4)}
+	destination, _ := url.Parse(server.URL)
+	addr := server.Listener.Addr().(*net.TCPAddr)
+	original := dnsTransport.NewHTTPSTransportWrapper(dialer, M.ParseSocksaddrHostPort("127.0.0.1", uint16(addr.Port)), destination)
+	defer original.Close()
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	outcomes := make(chan error, 2)
+	start := func(transport *dnsTransport.HTTPSTransportWrapper, path string) {
+		go func() {
+			req, _ := http.NewRequestWithContext(ctx, http.MethodPost, server.URL+path, nil)
+			_, err := transport.RoundTrip(req)
+			outcomes <- err
+		}()
+	}
+	start(original, "/original")
+	select {
+	case <-entered:
+	case <-ctx.Done():
+		t.Fatal("old generation did not connect")
+	}
+	oldLifetime := <-dialer.observed
+	original.CloseIdleConnections()
+	cloned := original.Clone()
+	start(cloned, "/cloned")
+	select {
+	case <-entered:
+	case <-ctx.Done():
+		t.Fatal("new generation did not connect")
+	}
+	newLifetime := <-dialer.observed
+	if oldLifetime.Err() != nil {
+		t.Fatal("idle close/reset killed an active old generation")
+	}
+	// Box.Close closes outbounds before DNS transports. Engine.Close alone
+	// does not own these dispatcher contexts, so final transport close must.
+	if err := engine.Close(); err != nil {
+		t.Fatal(err)
+	}
+	cloned.Close()
+	for range 2 {
+		select {
+		case err := <-outcomes:
+			if err == nil {
+				t.Fatal("shutdown completed a gated query")
+			}
+		case <-ctx.Done():
+			t.Fatal("shutdown leaked active stream")
+		}
+	}
+	for _, lifetime := range []context.Context{oldLifetime, newLifetime} {
+		if lifetime.Err() == nil {
+			t.Fatal("transport close did not cancel a detached connection")
+		}
+	}
+	for _, transport := range []*dnsTransport.HTTPSTransportWrapper{original, cloned} {
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, server.URL+"/closed", nil)
+		if _, err := transport.RoundTrip(req); err == nil {
+			t.Fatal("closed generation accepted a new dial")
+		}
+	}
+}
