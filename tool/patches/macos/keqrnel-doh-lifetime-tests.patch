+type localHTTP2Dialer struct {
+	engine    *xraybridge.Engine
+	tlsConfig *tls.Config
+	calls     atomic.Int32
+	observed  chan context.Context
+	finished  chan struct{}
+}
+
+func (d *localHTTP2Dialer) DialContext(ctx context.Context, _ string, dest M.Socksaddr) (net.Conn, error) {
+	d.calls.Add(1)
+	if d.observed != nil {
+		d.observed <- ctx
+	}
+	if d.finished != nil {
+		defer func() { d.finished <- struct{}{} }()
+	}
+	conn, err := d.engine.DialTCP(ctx, dest.Addr.String(), dest.Port)
+	if err != nil {
+		return nil, err
+	}
+	secured := tls.Client(conn, d.tlsConfig.Clone())
+	if err := secured.HandshakeContext(ctx); err != nil {
+		conn.Close()
+		return nil, err
+	}
+	return secured, nil
+}
+func (*localHTTP2Dialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, fmt.Errorf("packet dialing is forbidden in this TCP-only fixture")
+}
