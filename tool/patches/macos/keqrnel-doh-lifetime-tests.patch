+func TestDoHHTTP1FallbackKeepsTLSMetadata(t *testing.T) {
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { io.WriteString(w, "local-h1") }))
+	defer server.Close()
+	roots := x509.NewCertPool()
+	roots.AddCert(server.Certificate())
+	engine := localClientEngine(t, "freedom")
+	dialer := &localHTTP2Dialer{engine: engine, tlsConfig: &tls.Config{RootCAs: roots, ServerName: "127.0.0.1", NextProtos: []string{"h2", "http/1.1"}}}
+	destination, _ := url.Parse(server.URL)
+	addr := server.Listener.Addr().(*net.TCPAddr)
+	transport := dnsTransport.NewHTTPSTransportWrapper(dialer, M.ParseSocksaddrHostPort("127.0.0.1", uint16(addr.Port)), destination)
+	defer transport.Close()
+	ctx, cancel := context.WithTimeout(t.Context(), 4*time.Second)
+	defer cancel()
+	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, server.URL, nil)
+	response, err := transport.RoundTrip(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(response.Body)
+	if err != nil || string(body) != "local-h1" || response.ProtoMajor != 1 {
+		t.Fatalf("HTTP1 fallback failed: %v %q", err, body)
+	}
+	if response.TLS == nil || !response.TLS.HandshakeComplete {
+		t.Fatal("HTTP1 TLS metadata lost")
+	}
+	if dialer.calls.Load() != 2 {
+		t.Fatalf("ALPN fallback should replace exactly one H2 attempt: %d", dialer.calls.Load())
+	}
+}
