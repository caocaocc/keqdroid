+type stalledDoHDialer struct {
+	entered  chan context.Context
+	finished chan struct{}
+}
+
+func (d *stalledDoHDialer) DialContext(ctx context.Context, _ string, _ M.Socksaddr) (net.Conn, error) {
+	d.entered <- ctx
+	<-ctx.Done()
+	close(d.finished)
+	return nil, context.Cause(ctx)
+}
+func (*stalledDoHDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, errors.New("not used")
+}
+
+func TestDoHShutdownCancelsPendingDial(t *testing.T) {
+	dialer := &stalledDoHDialer{entered: make(chan context.Context, 1), finished: make(chan struct{})}
+	destination, _ := url.Parse("https://127.0.0.1:1/")
+	transport := dnsTransport.NewHTTPSTransportWrapper(dialer, M.ParseSocksaddrHostPort("127.0.0.1", 1), destination)
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	outcome := make(chan error, 1)
+	go func() {
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, destination.String(), nil)
+		_, err := transport.RoundTrip(req)
+		outcome <- err
+	}()
+	var lifetime context.Context
+	select {
+	case lifetime = <-dialer.entered:
+	case <-ctx.Done():
+		t.Fatal("pending dial did not start")
+	}
+	transport.Close()
+	select {
+	case <-dialer.finished:
+	case <-ctx.Done():
+		t.Fatal("pending dial ignored shutdown")
+	}
+	select {
+	case err := <-outcome:
+		if err == nil {
+			t.Fatal("pending shutdown returned success")
+		}
+	case <-ctx.Done():
+		t.Fatal("pending request survived shutdown")
+	}
+	if !errors.Is(context.Cause(lifetime), net.ErrClosed) {
+		t.Fatalf("shutdown cause: %v", context.Cause(lifetime))
+	}
+}
