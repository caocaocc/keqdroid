+func localClientEngine(t *testing.T, protocol string) *xraybridge.Engine {
+	t.Helper()
+	config := `{"log":{"loglevel":"none"},"outbounds":[{"protocol":"freedom","settings":{"finalRules":[{"action":"allow"}]}}]}`
+	if protocol == "vless" {
+		reservation, err := net.Listen("tcp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		port := reservation.Addr().(*net.TCPAddr).Port
+		reservation.Close()
+		const testID = "01234567-89ab-cdef-0123-456789abcdef"
+		serverConfig := fmt.Sprintf(`{"log":{"loglevel":"none"},"inbounds":[{"listen":"127.0.0.1","port":%d,"protocol":"vless","settings":{"clients":[{"id":%q}],"decryption":"none"},"streamSettings":{"network":"tcp","security":"none"}}],"outbounds":[{"protocol":"freedom","settings":{"finalRules":[{"action":"allow"}]}}]}`, port, testID)
+		server, err := xraybridge.NewEngine([]byte(serverConfig))
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { server.Close() })
+		config = fmt.Sprintf(`{"log":{"loglevel":"none"},"outbounds":[{"protocol":"vless","settings":{"vnext":[{"address":"127.0.0.1","port":%d,"users":[{"id":%q,"encryption":"none"}]}]},"streamSettings":{"network":"tcp","security":"none"}}]}`, port, testID)
+	}
+	engine, err := xraybridge.NewEngine([]byte(config))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { engine.Close() })
+	return engine
+}
