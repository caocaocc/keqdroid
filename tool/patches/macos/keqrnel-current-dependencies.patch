diff --git a/core/localdns/local_async_test.go b/core/localdns/local_async_test.go
new file mode 100644
--- /dev/null
+++ b/core/localdns/local_async_test.go
@@ -0,0 +1,49 @@
+package localdns
+
+import (
+	"context"
+	"errors"
+	mDNS "github.com/miekg/dns"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestLocalDNSAsyncCancellationKeepsResponseContract(t *testing.T) {
+	entered := make(chan context.Context, 4)
+	transport := &Transport{resolver: &net.Resolver{PreferGo: true, Dial: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		entered <- ctx
+		<-ctx.Done()
+		return nil, ctx.Err()
+	}}}
+	ctx, cancel := context.WithTimeout(t.Context(), 2*time.Second)
+	defer cancel()
+	query := new(mDNS.Msg)
+	query.SetQuestion("keqdis-async.invalid.", mDNS.TypeA)
+	result := make(chan *mDNS.Msg, 2)
+	failures := make(chan error, 2)
+	transport.ExchangeAsync(ctx, query, func(response *mDNS.Msg, err error) {
+		result <- response
+		failures <- err
+	})
+	select {
+	case <-entered:
+	case <-ctx.Done():
+		t.Fatal("asynchronous query did not reach resolver")
+	}
+	cancel()
+	select {
+	case response := <-result:
+		if err := <-failures; err != nil {
+			t.Fatal(err)
+		}
+		if response == nil || response.Id != query.Id || response.Rcode != mDNS.RcodeServerFailure {
+			t.Fatalf("changed local resolver failure contract: %v", response)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("cancellation lost before callback")
+	}
+	if !errors.Is(ctx.Err(), context.Canceled) {
+		t.Fatal("test did not explicitly cancel resolver")
+	}
+}
