diff --git a/transport/internet/keqdis_physical_socket.go b/transport/internet/keqdis_physical_socket.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/keqdis_physical_socket.go
@@ -0,0 +1,91 @@
+package internet
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"syscall"
+
+	"github.com/xtls/xray-core/common/errors"
+)
+
+// Kept separate from socket policy so the integration tests can exercise the
+// actual DefaultSystemDialer branches without opening a socket or sending data.
+var keqdisDialTCP = func(d *net.Dialer, ctx context.Context, network, address string) (net.Conn, error) {
+	return d.DialContext(ctx, network, address)
+}
+var keqdisListenUDP = func(c *net.ListenConfig, ctx context.Context, network, address string) (net.PacketConn, error) {
+	return c.ListenPacket(ctx, network, address)
+}
+
+// The UDP control address is the local bind address, not its peer. Keep the
+// destination separate; TCP's Control address is already resolved by net.Dialer.
+func keqdisSocketControl(ctx context.Context, destination string, sockopt *SocketConfig) func(string, string, syscall.RawConn) error {
+	return keqdisSocketControlWithOptions(ctx, destination, sockopt, applyOutboundSocketOptions)
+}
+
+func keqdisSocketControlWithOptions(ctx context.Context, destination string, sockopt *SocketConfig,
+	apply func(string, string, uintptr, *SocketConfig) error) func(string, string, syscall.RawConn) error {
+	return func(network, address string, socket syscall.RawConn) error {
+		strict := keqdisPhysicalSocketEnabled()
+		for _, controller := range Controllers {
+			if err := controller(network, address, socket); err != nil {
+				errors.LogInfoInner(ctx, err, "failed to apply external controller")
+				if strict {
+					return err
+				}
+			}
+		}
+		target := destination
+		if target == "" {
+			target = address
+		}
+		var optionErr error
+		if err := socket.Control(func(fd uintptr) {
+			if sockopt != nil {
+				optionErr = apply(network, target, fd, sockopt)
+				if optionErr != nil {
+					errors.LogInfoInner(ctx, optionErr, "failed to apply socket options")
+				}
+			}
+		}); err != nil {
+			return err
+		}
+		if strict && optionErr != nil {
+			return optionErr
+		}
+		// Last socket operation: an outbound's sockopt/controller cannot override
+		// the session's mandatory physical interface. Binding failures abort Dial.
+		return keqdisBindPhysicalSocket(network, target, socket)
+	}
+}
+
+func keqdisLoopbackDestination(address string) bool {
+	host, _, err := net.SplitHostPort(address)
+	if err != nil {
+		return false
+	}
+	if ip := net.ParseIP(host); ip != nil {
+		return ip.IsLoopback()
+	}
+	return false // No DNS queries, hostname guessing, or port-based exemption.
+}
+
+func keqdisRestrictLoopbackPacketConn(conn net.PacketConn, destination *net.UDPAddr) net.PacketConn {
+	if !keqdisPhysicalSocketEnabled() || !destination.IP.IsLoopback() {
+		return conn
+	}
+	// Xray freedom/Hysteria can access the underlying PacketConn and change a
+	// datagram's destination. A loopback-exempt socket must never send remotely.
+	return &keqdisLoopbackPacketConn{PacketConn: conn}
+}
+
+type keqdisLoopbackPacketConn struct{ net.PacketConn }
+
+func (c *keqdisLoopbackPacketConn) WriteTo(buffer []byte, address net.Addr) (int, error) {
+	peer, ok := address.(*net.UDPAddr)
+	if !ok || peer == nil || !peer.IP.IsLoopback() {
+		return 0, fmt.Errorf("physical socket: loopback-only UDP destination required")
+	}
+	return c.PacketConn.WriteTo(buffer, address)
+}
diff --git a/transport/internet/keqdis_physical_socket_darwin.go b/transport/internet/keqdis_physical_socket_darwin.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/keqdis_physical_socket_darwin.go
@@ -0,0 +1,118 @@
+//go:build darwin
+
+package internet
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"strings"
+	"syscall"
+)
+
+type keqdisPhysicalSocketState struct {
+	enabled   bool
+	name      string
+	index     int
+	err       error
+	lookup    func(string) (*net.Interface, error)
+	setOption func(int, int, int, int) error
+	getOption func(int, int, int) (int, error)
+}
+
+// Capture the helper-supplied identity once, before any embedded engine starts.
+// Per-socket checks reject a removed/replaced interface instead of using a new
+// interface with the same name or silently following the TUN's default route.
+var keqdisPhysicalSockets = keqdisLoadPhysicalSockets(os.LookupEnv, net.InterfaceByName)
+
+func keqdisLoadPhysicalSockets(env func(string) (string, bool), lookup func(string) (*net.Interface, error)) *keqdisPhysicalSocketState {
+	dns, haveDNS := env("KEQDIS_BOOTSTRAP_DNS")
+	name, haveInterface := env("KEQDIS_BOOTSTRAP_INTERFACE")
+	s := &keqdisPhysicalSocketState{enabled: haveDNS || haveInterface, name: name,
+		lookup: lookup, setOption: syscall.SetsockoptInt, getOption: syscall.GetsockoptInt}
+	if !s.enabled {
+		return s
+	}
+	if !haveDNS || !haveInterface || strings.TrimSpace(dns) == "" || !keqdisPhysicalInterfaceName(name) {
+		s.err = fmt.Errorf("physical socket: incomplete or invalid protected network context")
+		return s
+	}
+	iface, err := lookup(name)
+	if err != nil {
+		s.err = fmt.Errorf("physical socket: interface lookup: %w", err)
+		return s
+	}
+	if !keqdisPhysicalInterface(iface, name) {
+		s.err = fmt.Errorf("physical socket: interface is not active physical context")
+		return s
+	}
+	s.index = iface.Index
+	return s
+}
+
+func keqdisPhysicalInterfaceName(name string) bool {
+	if name == "" || len(name) > 15 || name == "lo0" || strings.HasPrefix(name, "utun") || strings.HasPrefix(name, "tun") || strings.HasPrefix(name, "tap") {
+		return false
+	}
+	for _, c := range name {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c == '-') {
+			return false
+		}
+	}
+	return true
+}
+
+func keqdisPhysicalInterface(iface *net.Interface, name string) bool {
+	return iface != nil && iface.Name == name && iface.Index > 0 && iface.Flags&net.FlagUp != 0 && iface.Flags&net.FlagLoopback == 0
+}
+
+func keqdisPhysicalSocketEnabled() bool { return keqdisPhysicalSockets.enabled }
+
+func keqdisBindPhysicalSocket(network, address string, socket syscall.RawConn) error {
+	s := keqdisPhysicalSockets
+	if !s.enabled {
+		return nil
+	}
+	if s.err != nil {
+		return s.err
+	}
+	iface, err := s.lookup(s.name)
+	if err != nil {
+		return fmt.Errorf("physical socket: interface disappeared: %w", err)
+	}
+	if !keqdisPhysicalInterface(iface, s.name) || iface.Index != s.index {
+		return fmt.Errorf("physical socket: interface changed; rebuild the network session")
+	}
+	if keqdisLoopbackDestination(address) {
+		return nil
+	}
+	if host, _, err := net.SplitHostPort(address); err != nil || net.ParseIP(strings.Split(host, "%")[0]) == nil {
+		return fmt.Errorf("physical socket: unresolved destination")
+	}
+	level, option := syscall.IPPROTO_IP, syscall.IP_BOUND_IF
+	switch network {
+	case "tcp4", "udp4":
+	case "tcp6", "udp6":
+		level, option = syscall.IPPROTO_IPV6, syscall.IPV6_BOUND_IF
+	default:
+		return fmt.Errorf("physical socket: unsupported socket network")
+	}
+	var bindErr error
+	if err := socket.Control(func(fd uintptr) {
+		bindErr = s.setOption(int(fd), level, option, s.index)
+		if bindErr != nil {
+			return
+		}
+		var actual int
+		actual, bindErr = s.getOption(int(fd), level, option)
+		if bindErr == nil && actual != s.index {
+			bindErr = fmt.Errorf("physical socket: interface binding verification failed")
+		}
+	}); err != nil {
+		return fmt.Errorf("physical socket: descriptor control: %w", err)
+	}
+	if bindErr != nil {
+		return fmt.Errorf("physical socket: mandatory interface binding: %w", bindErr)
+	}
+	return nil
+}
