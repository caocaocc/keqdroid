+func TestKeqdisPhysicalDefaultUDPLoopbackCannotChangeToRemotePeer(t *testing.T) {
+	_, calls := keqdisTestPhysicalState(t)
+	old := keqdisListenUDP
+	t.Cleanup(func() { keqdisListenUDP = old })
+	underlying := &keqdisTestPacketConn{}
+	keqdisListenUDP = func(c *net.ListenConfig, ctx context.Context, network, address string) (net.PacketConn, error) {
+		return underlying, c.Control("udp6", "[::]:0", keqdisTestRawConn{})
+	}
+	conn, err := (&DefaultSystemDialer{}).Dial(context.Background(), nil, xnet.UDPDestination(xnet.IPAddress(net.ParseIP("127.0.0.1")), 1080), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wrapper := conn.(*PacketConnWrapper)
+	// Exercise the field used directly by transports, not just net.Conn.Write.
+	if _, err = wrapper.PacketConn.WriteTo([]byte{1}, &net.UDPAddr{IP: net.ParseIP("198.51.100.7"), Port: 1080}); err == nil {
+		t.Fatal("default dialer left loopback UDP socket unrestricted")
+	}
+	if _, err = conn.Write([]byte{1}); err != nil {
+		t.Fatal(err)
+	}
+	if len(*calls) != 0 || underlying.writes != 1 {
+		t.Fatalf("loopback path changed: bindings=%v writes=%d", *calls, underlying.writes)
+	}
+}
