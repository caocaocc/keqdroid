--- /dev/null
+++ b/transport/internet/keqdis_physical_socket_darwin_test.go
@@ -0,0 +1,283 @@
+//go:build darwin
+
+package internet
+
+import (
+	"context"
+	"errors"
+	"net"
+	"reflect"
+	"syscall"
+	"testing"
+	"time"
+
+	xnet "github.com/xtls/xray-core/common/net"
+)
+
+type keqdisTestRawConn struct{ err error }
+
+func (s keqdisTestRawConn) Control(f func(uintptr)) error {
+	if s.err != nil {
+		return s.err
+	}
+	f(7)
+	return nil
+}
+func (s keqdisTestRawConn) Read(func(uintptr) bool) error  { panic("unexpected socket read") }
+func (s keqdisTestRawConn) Write(func(uintptr) bool) error { panic("unexpected socket write") }
+
+type keqdisTestPacketConn struct{ writes int }
+
+func (c *keqdisTestPacketConn) ReadFrom([]byte) (int, net.Addr, error) {
+	panic("unexpected packet read")
+}
+func (c *keqdisTestPacketConn) WriteTo(b []byte, _ net.Addr) (int, error) {
+	c.writes++
+	return len(b), nil
+}
+func (*keqdisTestPacketConn) Close() error                     { return nil }
+func (*keqdisTestPacketConn) LocalAddr() net.Addr              { return &net.UDPAddr{} }
+func (*keqdisTestPacketConn) SetDeadline(time.Time) error      { return nil }
+func (*keqdisTestPacketConn) SetReadDeadline(time.Time) error  { return nil }
+func (*keqdisTestPacketConn) SetWriteDeadline(time.Time) error { return nil }
+
+func keqdisTestPhysicalState(t *testing.T) (*keqdisPhysicalSocketState, *[]int) {
+	t.Helper()
+	previous, controllers := keqdisPhysicalSockets, Controllers
+	t.Cleanup(func() { keqdisPhysicalSockets = previous; Controllers = controllers })
+	Controllers = nil
+	calls := []int{}
+	s := &keqdisPhysicalSocketState{enabled: true, name: "en0", index: 9,
+		lookup: func(name string) (*net.Interface, error) {
+			return &net.Interface{Name: name, Index: 9, Flags: net.FlagUp}, nil
+		},
+		setOption: func(fd, level, option, index int) error { calls = append(calls, level, option, index); return nil },
+		getOption: func(fd, level, option int) (int, error) { return 9, nil }}
+	keqdisPhysicalSockets = s
+	return s, &calls
+}
+
+func TestKeqdisPhysicalDefaultDialerUsesBothActualControlPaths(t *testing.T) {
+	_, calls := keqdisTestPhysicalState(t)
+	oldTCP, oldUDP := keqdisDialTCP, keqdisListenUDP
+	t.Cleanup(func() { keqdisDialTCP = oldTCP; keqdisListenUDP = oldUDP })
+	keqdisDialTCP = func(d *net.Dialer, ctx context.Context, network, address string) (net.Conn, error) {
+		if d.Control == nil {
+			t.Error("TCP without sockopt/controller has no physical protection")
+			return nil, nil
+		}
+		return nil, d.Control("tcp4", address, keqdisTestRawConn{})
+	}
+	keqdisListenUDP = func(c *net.ListenConfig, ctx context.Context, network, address string) (net.PacketConn, error) {
+		// Even an IPv4 destination may use a dual-stack wildcard UDP socket.
+		if c.Control == nil {
+			t.Fatal("UDP has no physical protection")
+		}
+		return &keqdisTestPacketConn{}, c.Control("udp6", "[::]:0", keqdisTestRawConn{})
+	}
+	d := &DefaultSystemDialer{}
+	for _, network := range []xnet.Network{xnet.Network_TCP, xnet.Network_UDP} {
+		_, err := d.Dial(context.Background(), nil, xnet.Destination{Network: network, Address: xnet.IPAddress(net.ParseIP("198.51.100.7")), Port: 53}, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	want := []int{syscall.IPPROTO_IP, syscall.IP_BOUND_IF, 9, syscall.IPPROTO_IPV6, syscall.IPV6_BOUND_IF, 9}
+	if !reflect.DeepEqual(*calls, want) {
+		t.Fatalf("missing physical binding: %v", *calls)
+	}
+}
+
+func TestKeqdisPhysicalDefaultDialerPropagatesMandatoryBindingErrors(t *testing.T) {
+	s, _ := keqdisTestPhysicalState(t)
+	failure := errors.New("denied binding")
+	s.setOption = func(int, int, int, int) error { return failure }
+	oldTCP, oldUDP := keqdisDialTCP, keqdisListenUDP
+	t.Cleanup(func() { keqdisDialTCP = oldTCP; keqdisListenUDP = oldUDP })
+	keqdisDialTCP = func(d *net.Dialer, ctx context.Context, network, address string) (net.Conn, error) {
+		if d.Control == nil {
+			return nil, nil
+		}
+		return nil, d.Control("tcp4", address, keqdisTestRawConn{})
+	}
+	keqdisListenUDP = func(c *net.ListenConfig, ctx context.Context, network, address string) (net.PacketConn, error) {
+		return &keqdisTestPacketConn{}, c.Control("udp4", "0.0.0.0:0", keqdisTestRawConn{})
+	}
+	for _, network := range []xnet.Network{xnet.Network_TCP, xnet.Network_UDP} {
+		_, err := (&DefaultSystemDialer{}).Dial(context.Background(), nil, xnet.Destination{Network: network, Address: xnet.IPAddress(net.ParseIP("198.51.100.7")), Port: 443}, nil)
+		if !errors.Is(err, failure) {
+			t.Errorf("binding failure swallowed for %v: %v", network, err)
+		}
+	}
+}
+
+func TestKeqdisPhysicalOptionsCannotOverwriteMandatoryBinding(t *testing.T) {
+	s, _ := keqdisTestPhysicalState(t)
+	sequence := []string{}
+	Controllers = []func(string, string, syscall.RawConn) error{func(string, string, syscall.RawConn) error { sequence = append(sequence, "controller"); return nil }}
+	s.setOption = func(int, int, int, int) error { sequence = append(sequence, "physical"); return nil }
+	s.getOption = func(int, int, int) (int, error) { sequence = append(sequence, "verify"); return 9, nil }
+	apply := func(string, string, uintptr, *SocketConfig) error { sequence = append(sequence, "sockopt"); return nil }
+	err := keqdisSocketControlWithOptions(context.Background(), "", &SocketConfig{}, apply)("tcp4", "198.51.100.7:443", keqdisTestRawConn{})
+	if err != nil || !reflect.DeepEqual(sequence, []string{"controller", "sockopt", "physical", "verify"}) {
+		t.Fatalf("wrong socket order: %v %v", sequence, err)
+	}
+}
+
+func TestKeqdisPhysicalFailuresAreClosed(t *testing.T) {
+	for _, test := range []string{"controller", "sockopt", "control", "setsockopt", "getsockopt", "wrong-index", "missing-interface", "replaced-interface", "down-interface"} {
+		t.Run(test, func(t *testing.T) {
+			s, _ := keqdisTestPhysicalState(t)
+			failure := errors.New("fixture failure")
+			raw := keqdisTestRawConn{}
+			apply := func(string, string, uintptr, *SocketConfig) error { return nil }
+			switch test {
+			case "controller":
+				Controllers = []func(string, string, syscall.RawConn) error{func(string, string, syscall.RawConn) error { return failure }}
+			case "sockopt":
+				apply = func(string, string, uintptr, *SocketConfig) error { return failure }
+			case "control":
+				raw.err = failure
+			case "setsockopt":
+				s.setOption = func(int, int, int, int) error { return failure }
+			case "getsockopt":
+				s.getOption = func(int, int, int) (int, error) { return 0, failure }
+			case "wrong-index":
+				s.getOption = func(int, int, int) (int, error) { return 3, nil }
+			case "missing-interface":
+				s.lookup = func(string) (*net.Interface, error) { return nil, failure }
+			case "replaced-interface":
+				s.lookup = func(n string) (*net.Interface, error) {
+					return &net.Interface{Name: n, Index: 10, Flags: net.FlagUp}, nil
+				}
+			case "down-interface":
+				s.lookup = func(n string) (*net.Interface, error) { return &net.Interface{Name: n, Index: 9}, nil }
+			}
+			if err := keqdisSocketControlWithOptions(context.Background(), "", &SocketConfig{}, apply)("tcp4", "198.51.100.7:443", raw); err == nil {
+				t.Fatal("unsafe socket accepted")
+			}
+		})
+	}
+}
