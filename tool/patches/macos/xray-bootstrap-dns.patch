+func TestKeqdisPhysicalNoContextPreservesLegacyControllerAndOptionsBehavior(t *testing.T) {
+	s, calls := keqdisTestPhysicalState(t)
+	s.enabled = false
+	failure := errors.New("legacy ignored option")
+	Controllers = []func(string, string, syscall.RawConn) error{func(string, string, syscall.RawConn) error { return failure }}
+	if err := keqdisSocketControlWithOptions(context.Background(), "", &SocketConfig{}, func(string, string, uintptr, *SocketConfig) error { return failure })("tcp4", "198.51.100.7:443", keqdisTestRawConn{}); err != nil {
+		t.Fatal(err)
+	}
+	if len(*calls) != 0 {
+		t.Fatal("ordinary Proxy session got physical binding")
+	}
+	underlying := &keqdisTestPacketConn{}
+	if keqdisRestrictLoopbackPacketConn(underlying, &net.UDPAddr{IP: net.ParseIP("127.0.0.1")}) != underlying {
+		t.Fatal("ordinary Proxy packet semantics changed")
+	}
+}
