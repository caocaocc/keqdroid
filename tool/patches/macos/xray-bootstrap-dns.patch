+func TestKeqdisPhysicalLoopbackUsesExactPeerAndRestrictsUnderlyingUDP(t *testing.T) {
+	_, calls := keqdisTestPhysicalState(t)
+	for _, address := range []string{"127.0.0.1:443", "127.9.8.7:53", "[::1]:51820", "[::ffff:127.0.0.1]:53"} {
+		if err := keqdisSocketControl(context.Background(), address, nil)("udp6", "[::]:0", keqdisTestRawConn{}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(*calls) != 0 {
+		t.Fatal("loopback was pinned to a physical interface")
+	}
+	for _, address := range []string{"198.51.100.7:1080", "192.0.2.1:53"} {
+		if err := keqdisSocketControl(context.Background(), address, nil)("udp4", "0.0.0.0:0", keqdisTestRawConn{}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(*calls) != 6 {
+		t.Fatal("port-based or wildcard exemption allowed remote UDP")
+	}
+	underlying := &keqdisTestPacketConn{}
+	packet := keqdisRestrictLoopbackPacketConn(underlying, &net.UDPAddr{IP: net.ParseIP("127.0.0.1"), Port: 1080})
+	if _, err := packet.WriteTo([]byte{1}, &net.UDPAddr{IP: net.ParseIP("198.51.100.7"), Port: 1080}); err == nil {
+		t.Fatal("loopback socket leaked to remote peer")
+	}
+	if _, err := packet.WriteTo([]byte{1}, &net.UDPAddr{IP: net.ParseIP("::1"), Port: 53}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := packet.WriteTo([]byte{1}, (*net.UDPAddr)(nil)); err == nil {
+		t.Fatal("nil UDP peer accepted")
+	}
+	if underlying.writes != 1 {
+		t.Fatal("rejected packet reached underlying socket")
+	}
+}
