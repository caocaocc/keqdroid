+func TestKeqdisPhysicalSnapshotIsStrictAndPinned(t *testing.T) {
+	lookup := func(name string) (*net.Interface, error) {
+		return &net.Interface{Name: name, Index: 9, Flags: net.FlagUp}, nil
+	}
+	for _, test := range []struct {
+		name                   string
+		dns                    string
+		dnsSet                 bool
+		iface                  string
+		ifaceSet               bool
+		wantEnabled, wantError bool
+	}{
+		{"none", "", false, "", false, false, false}, {"missing-dns", "", false, "en0", true, true, true}, {"missing-interface", "[]", true, "", false, true, true},
+		{"tun", "[]", true, "utun9", true, true, true}, {"loopback", "[]", true, "lo0", true, true, true}, {"malformed", "[]", true, "en0;bad", true, true, true},
+		{"valid", "[\"192.0.2.1\"]", true, "en0", true, true, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			s := keqdisLoadPhysicalSockets(func(k string) (string, bool) {
+				if k == "KEQDIS_BOOTSTRAP_DNS" {
+					return test.dns, test.dnsSet
+				}
+				return test.iface, test.ifaceSet
+			}, lookup)
+			if s.enabled != test.wantEnabled || (s.err != nil) != test.wantError {
+				t.Fatalf("invalid snapshot state: %+v", s)
+			}
+		})
+	}
+}
