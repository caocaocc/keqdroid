diff --git a/bridge/xray/keqdis_routing_darwin.go b/bridge/xray/keqdis_routing_darwin.go
new file mode 100644
--- /dev/null
+++ b/bridge/xray/keqdis_routing_darwin.go
@@ -0,0 +1,55 @@
+//go:build darwin && !ios
+
+package xray
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/adapter"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+)
+
+// Preserve TUN identity for application rules and the fixed LAN listeners for
+// Xray's LAN source allow/deny rules. Ordinary loopback proxy and DNS dispatches
+// do not inherit an application's TUN routing policy.
+func keqdisRoutingContext(ctx context.Context) context.Context {
+	// DNS transports inherit the original ingress metadata. The transport tag
+	// marks their own upstream dial, even when that tag is an empty string.
+	if _, dnsTransport := adapter.DNSTransportTagFromContext(ctx); dnsTransport {
+		return ctx
+	}
+	metadata := adapter.ContextFrom(ctx)
+	if metadata == nil || !metadata.Source.Addr.IsValid() || metadata.Source.Port == 0 {
+		return ctx
+	}
+	switch metadata.Inbound {
+	case "tun-in":
+		if metadata.InboundType != "tun" {
+			return ctx
+		}
+	case "socks-lan":
+		if metadata.InboundType != "socks" {
+			return ctx
+		}
+	case "http-lan":
+		if metadata.InboundType != "http" {
+			return ctx
+		}
+	default:
+		return ctx
+	}
+	var network xnet.Network
+	switch metadata.Network {
+	case "tcp":
+		network = xnet.Network_TCP
+	case "udp":
+		network = xnet.Network_UDP
+	default:
+		return ctx
+	}
+	return session.ContextWithInbound(ctx, &session.Inbound{
+		Source: xnet.Destination{Network: network, Address: xnet.IPAddress(metadata.Source.Addr.AsSlice()), Port: xnet.Port(metadata.Source.Port)},
+		Tag:    metadata.Inbound, Name: metadata.InboundType,
+	})
+}
