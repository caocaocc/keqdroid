diff --git a/dns/transport/https_lifetime_darwin.go b/dns/transport/https_lifetime_darwin.go
new file mode 100644
--- /dev/null
+++ b/dns/transport/https_lifetime_darwin.go
@@ -0,0 +1,136 @@
+package transport
+
+import (
+	"context"
+	"net"
+	"sync"
+
+	"github.com/sagernet/sing-box/common/tls"
+)
+
+// The embedded Xray dispatcher keeps its dialing context for the whole stream.
+// A completed DNS request must not close other requests sharing its HTTP/2 conn.
+type httpsConnectionLifetime struct {
+	mu     sync.Mutex
+	closed bool
+	leases map[*httpsConnectionLease]struct{}
+}
+
+type httpsConnectionLease struct {
+	owner  *httpsConnectionLifetime
+	ctx    context.Context
+	cancel context.CancelCauseFunc
+	closed bool     // protected by owner.mu
+	conn   net.Conn // protected by owner.mu
+}
+
+func newHTTPSConnectionLifetime() *httpsConnectionLifetime {
+	return &httpsConnectionLifetime{leases: make(map[*httpsConnectionLease]struct{})}
+}
+
+func (o *httpsConnectionLifetime) dial(ctx context.Context, dial func(context.Context) (net.Conn, error)) (net.Conn, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	lifetime, cancel := context.WithCancelCause(context.WithoutCancel(ctx))
+	lease := &httpsConnectionLease{owner: o, ctx: lifetime, cancel: cancel}
+	o.mu.Lock()
+	if o.closed {
+		o.mu.Unlock()
+		cancel(net.ErrClosed)
+		return nil, net.ErrClosed
+	}
+	o.leases[lease] = struct{}{}
+	o.mu.Unlock()
+	stopCaller := context.AfterFunc(ctx, func() { lease.close(context.Cause(ctx)) })
+	defer stopCaller()
+	// NewHTTPSRaw has already installed the TLS dialer. Its return is the
+	// actual TLS handshake boundary; core.Dial alone returns too early.
+	conn, err := dial(lifetime)
+	if err != nil {
+		lease.close(err)
+		if conn != nil {
+			conn.Close()
+		}
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		return nil, err
+	}
+	if !stopCaller() || ctx.Err() != nil {
+		lease.close(context.Cause(ctx))
+		conn.Close()
+		return nil, ctx.Err()
+	}
+	// Shutdown may race the successful handshake, so attach and close share
+	// a lock. A late connection must be closed instead of escaping ownership.
+	o.mu.Lock()
+	attached := !o.closed && !lease.closed
+	if attached {
+		lease.conn = conn
+	}
+	o.mu.Unlock()
+	if !attached {
+		conn.Close()
+		lease.close(net.ErrClosed)
+		cause := context.Cause(lifetime)
+		if cause == nil {
+			cause = net.ErrClosed
+		}
+		return nil, cause
+	}
+	owned := &httpsOwnedConn{Conn: conn, lease: lease}
+	if secured, ok := conn.(tls.Conn); ok {
+		return &httpsOwnedTLSConn{httpsOwnedConn: owned, secured: secured}, nil
+	}
+	return owned, nil
+}
+
+func (o *httpsConnectionLifetime) close() {
+	o.mu.Lock()
+	o.closed = true
+	leases := make([]*httpsConnectionLease, 0, len(o.leases))
+	for lease := range o.leases {
+		leases = append(leases, lease)
+	}
+	o.mu.Unlock()
+	for _, lease := range leases {
+		lease.close(net.ErrClosed)
+	}
+}
+
+func (l *httpsConnectionLease) close(cause error) error {
+	l.owner.mu.Lock()
+	if l.closed {
+		l.owner.mu.Unlock()
+		return nil
+	}
+	l.closed = true
+	conn := l.conn
+	l.conn = nil
+	delete(l.owner.leases, l)
+	l.owner.mu.Unlock()
+	l.cancel(cause)
+	if conn != nil {
+		return conn.Close()
+	}
+	return nil
+}
+
+type httpsOwnedConn struct {
+	net.Conn
+	lease *httpsConnectionLease
+}
+
+func (c *httpsOwnedConn) Close() error { return c.lease.close(context.Canceled) }
+
+type httpsOwnedTLSConn struct {
+	*httpsOwnedConn
+	secured tls.Conn
+}
+
+func (c *httpsOwnedTLSConn) NetConn() net.Conn { return c.secured.NetConn() }
+func (c *httpsOwnedTLSConn) HandshakeContext(ctx context.Context) error {
+	return c.secured.HandshakeContext(ctx)
+}
+func (c *httpsOwnedTLSConn) ConnectionState() tls.ConnectionState { return c.secured.ConnectionState() }
