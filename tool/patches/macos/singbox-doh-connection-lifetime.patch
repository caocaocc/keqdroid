@@ -0,0 +1,16 @@
+//go:build !darwin
+
+package transport
+
+import (
+	"context"
+	"net"
+)
+
+type httpsConnectionLifetime struct{}
+
+func newHTTPSConnectionLifetime() *httpsConnectionLifetime { return &httpsConnectionLifetime{} }
+func (*httpsConnectionLifetime) dial(ctx context.Context, dial func(context.Context) (net.Conn, error)) (net.Conn, error) {
+	return dial(ctx)
+}
+func (*httpsConnectionLifetime) close() {}
diff --git a/dns/transport/https_lifetime_darwin_test.go b/dns/transport/https_lifetime_darwin_test.go
new file mode 100644
--- /dev/null
+++ b/dns/transport/https_lifetime_darwin_test.go
@@ -0,0 +1,87 @@
+package transport
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type lifetimeCloseRecorder struct {
+	net.Conn
+	closes atomic.Int32
+}
+
+func (c *lifetimeCloseRecorder) Close() error { c.closes.Add(1); return nil }
+
+type lifetimeDialResult struct {
+	conn net.Conn
+	err  error
+}
+
+func TestHTTPSLifetimeLateAttachAfterShutdown(t *testing.T) {
+	owner := newHTTPSConnectionLifetime()
+	entered, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	unblock := func() { once.Do(func() { close(release) }) }
+	defer unblock()
+	raw := &lifetimeCloseRecorder{}
+	result := make(chan lifetimeDialResult, 1)
+	go func() {
+		conn, err := owner.dial(t.Context(), func(context.Context) (net.Conn, error) { close(entered); <-release; return raw, nil })
+		result <- lifetimeDialResult{conn, err}
+	}()
+	<-entered
+	owner.close()
+	unblock()
+	select {
+	case value := <-result:
+		if value.conn != nil || !errors.Is(value.err, net.ErrClosed) {
+			t.Fatalf("late attach: conn=%v err=%v", value.conn, value.err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("late dial did not return")
+	}
+	if raw.closes.Load() != 1 {
+		t.Fatalf("late connection close count=%d", raw.closes.Load())
+	}
+}
+
+func TestHTTPSLifetimeClosedBeforeCancelHasNonNilError(t *testing.T) {
+	owner := newHTTPSConnectionLifetime()
+	cancelEntered, releaseCancel, closeDone := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	unblock := func() { once.Do(func() { close(releaseCancel) }) }
+	defer unblock()
+	raw := &lifetimeCloseRecorder{}
+	conn, err := owner.dial(t.Context(), func(context.Context) (net.Conn, error) {
+		owner.mu.Lock()
+		var lease *httpsConnectionLease
+		for item := range owner.leases {
+			lease = item
+		}
+		originalCancel := lease.cancel
+		lease.cancel = func(cause error) { close(cancelEntered); <-releaseCancel; originalCancel(cause) }
+		owner.mu.Unlock()
+		go func() { lease.close(net.ErrClosed); close(closeDone) }()
+		// close has set its flag and removed the lease, but cancellation has
+		// deliberately not run yet. A nil context cause cannot mean success.
+		<-cancelEntered
+		return raw, nil
+	})
+	if conn != nil || !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("shutdown must never return nil,nil: conn=%v err=%v", conn, err)
+	}
+	if raw.closes.Load() != 1 {
+		t.Fatalf("late connection close count=%d", raw.closes.Load())
+	}
+	unblock()
+	select {
+	case <-closeDone:
+	case <-time.After(2 * time.Second):
+		t.Fatal("close did not finish")
+	}
+}
